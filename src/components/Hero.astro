---
import { url } from '../site.config';

interface Props {
  image: string;
  imageAlt: string;
}
const { image, imageAlt } = Astro.props;
---

<section class="relative isolate overflow-hidden md:min-h-[82vh]">
  <!--
    מובייל: התמונה מוצגת כבאנר מלא למעלה (יחס רוחבי) כך שרואים את כל הפאנורמה,
    והטקסט מתחתיה על רקע קרם.
    דסקטופ (md+): אותה תמונה הופכת לרקע מלא, והטקסט ממורכז מעליה עם הילה בהירה.
  -->
  <img
    src={url(image)}
    alt={imageAlt}
    fetchpriority="high"
    class="block aspect-[16/10] w-full object-cover md:absolute md:inset-0 md:-z-10 md:aspect-auto md:h-full"
  />

  <!-- הילה בהירה מאחורי הטקסט — בדסקטופ בלבד -->
  <div
    class="absolute inset-0 -z-10 hidden md:block"
    style="background: radial-gradient(ellipse 72% 62% at 50% 46%, rgba(250,246,238,0.66) 0%, rgba(250,246,238,0.30) 46%, rgba(250,246,238,0) 76%);"
    aria-hidden="true"
  >
  </div>

  <div
    class="hero-text animate-fade-up bg-sand-100 px-5 pb-12 pt-9 text-center md:absolute md:inset-0 md:mx-auto md:flex md:max-w-6xl md:flex-col md:items-center md:justify-center md:bg-transparent md:px-5 md:py-28"
  >
    <div>
      <h1 class="font-serif font-black leading-[0.95] text-sea-700">
        <span class="block text-6xl sm:text-7xl md:text-8xl">קיסריה</span>
        <span class="mt-2 block text-3xl text-sea-600 sm:text-4xl md:mt-3 md:text-5xl">
          עיר מתוך חלום
        </span>
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-ink-700 sm:text-xl md:mt-7">
        סיפורים ומאמרים על אחת הערים המרתקות בהיסטוריה של ארץ ישראל.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3 md:mt-9">
        <a
          href={url('/articles')}
          class="rounded-full bg-terracotta-500 px-7 py-3 font-medium text-sand-50 shadow-lg transition-transform hover:-translate-y-0.5 hover:bg-terracotta-600"
        >
          לקריאת המאמרים
        </a>
        <a
          href={url('/tours')}
          class="rounded-full border border-sea-600/40 bg-sand-50/70 px-7 py-3 font-medium text-sea-700 backdrop-blur-sm transition-colors hover:bg-sand-50"
        >
          על הסיורים
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 768px) {
    .hero-text h1 {
      text-shadow: 0 1px 22px rgba(250, 246, 238, 0.75);
    }
    .hero-text p {
      text-shadow: 0 1px 14px rgba(250, 246, 238, 0.85);
    }
  }
</style>
