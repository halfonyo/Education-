---
import { url } from '../site.config';

interface Props {
  image: string;
  imageAlt: string;
}
const { image, imageAlt } = Astro.props;
---

<section class="relative isolate overflow-hidden">
  <!-- תמונת רקע רוחב מלא -->
  <img
    src={url(image)}
    alt={imageAlt}
    class="absolute inset-0 -z-10 h-full w-full object-cover"
    fetchpriority="high"
  />
  <!-- הילה בהירה מאחורי הטקסט לקריאוּת על גבי הרקע הבהיר -->
  <div
    class="absolute inset-0 -z-10"
    style="background: radial-gradient(ellipse 72% 62% at 50% 46%, rgba(250,246,238,0.66) 0%, rgba(250,246,238,0.30) 46%, rgba(250,246,238,0) 76%);"
    aria-hidden="true"
  >
  </div>

  <div class="container-page flex min-h-[82vh] flex-col items-center justify-center py-28 text-center">
    <div class="hero-text animate-fade-up">
      <h1 class="font-serif font-black leading-[0.95] text-sea-700">
        <span class="block text-6xl sm:text-7xl md:text-8xl">קיסריה</span>
        <span class="mt-3 block text-3xl font-bold text-sea-600 sm:text-4xl md:text-5xl">
          עיר מתוך חלום
        </span>
      </h1>
      <p class="mx-auto mt-7 max-w-xl text-lg text-ink-700 sm:text-xl">
        מאגר מאמרים וסיפורים על אחת הערים המרתקות בארץ — וסיורים מודרכים שמחזירים אותה לחיים.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a
          href={url('/articles')}
          class="rounded-full bg-terracotta-500 px-7 py-3 font-medium text-sand-50 shadow-lg transition-transform hover:-translate-y-0.5 hover:bg-terracotta-600"
        >
          לקריאת המאמרים
        </a>
        <a
          href={url('/tours')}
          class="rounded-full border border-sea-600/40 bg-sand-50/70 px-7 py-3 font-medium text-sea-700 backdrop-blur-sm transition-colors hover:bg-sand-50"
        >
          על הסיורים
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-text h1 {
    text-shadow: 0 1px 22px rgba(250, 246, 238, 0.75);
  }
  .hero-text p {
    text-shadow: 0 1px 14px rgba(250, 246, 238, 0.85);
  }
</style>
