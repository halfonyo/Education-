---
import { url } from '../site.config';

interface Props {
  image: string;
  imageAlt: string;
}
const { image, imageAlt } = Astro.props;
---

<section class="relative isolate overflow-hidden">
  <!-- תמונת רקע רוחב מלא — במובייל ממוקדת אל המקדש והים -->
  <img
    src={url(image)}
    alt={imageAlt}
    fetchpriority="high"
    class="absolute inset-0 -z-10 h-full w-full object-cover object-[28%_center] md:object-center"
  />
  <!-- הילה בהירה מאחורי הטקסט לקריאוּת על גבי הרקע הבהיר -->
  <div
    class="absolute inset-0 -z-10"
    style="background: radial-gradient(ellipse 92% 55% at 50% 52%, rgba(250,246,238,0.72) 0%, rgba(250,246,238,0.34) 48%, rgba(250,246,238,0) 78%);"
    aria-hidden="true"
  >
  </div>

  <div class="container-page flex min-h-[86svh] flex-col items-center justify-center py-24 text-center md:min-h-[82vh] md:py-28">
    <div class="hero-text animate-fade-up">
      <h1 class="font-serif font-black leading-[0.95] text-sea-700">
        <span class="block text-7xl sm:text-7xl md:text-8xl">קיסריה</span>
        <span class="mt-2 block text-3xl text-sea-600 sm:text-4xl md:mt-3 md:text-5xl">
          עיר מתוך חלום
        </span>
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg text-ink-700 sm:text-xl md:mt-7">
        סיפורים ומאמרים על אחת הערים המרתקות בהיסטוריה של ארץ ישראל.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3 md:mt-9">
        <a
          href={url('/articles')}
          class="rounded-full bg-terracotta-500 px-7 py-3 font-medium text-sand-50 shadow-lg transition-transform hover:-translate-y-0.5 hover:bg-terracotta-600"
        >
          לקריאת המאמרים
        </a>
        <a
          href={url('/tours')}
          class="rounded-full border border-sea-600/40 bg-sand-50/70 px-7 py-3 font-medium text-sea-700 backdrop-blur-sm transition-colors hover:bg-sand-50"
        >
          על הסיורים
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-text h1 {
    text-shadow: 0 1px 22px rgba(250, 246, 238, 0.85);
  }
  .hero-text p {
    text-shadow: 0 1px 14px rgba(250, 246, 238, 0.9);
  }
</style>
