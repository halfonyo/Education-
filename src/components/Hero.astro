---
import { site } from '../site.config';

import { url } from '../site.config';

interface Props {
  image: string;
  imageAlt: string;
}
const { image, imageAlt } = Astro.props;
---

<section class="relative isolate overflow-hidden">
  <!-- תמונת רקע רוחב מלא -->
  <img
    src={url(image)}
    alt={imageAlt}
    class="absolute inset-0 -z-10 h-full w-full object-cover"
    fetchpriority="high"
  />
  <!-- שכבת הכהיה חמה לקריאוּת -->
  <div
    class="absolute inset-0 -z-10"
    style="background: linear-gradient(180deg, rgba(27,57,68,0.35) 0%, rgba(42,35,28,0.55) 55%, rgba(42,35,28,0.78) 100%);"
    aria-hidden="true"
  >
  </div>

  <div class="container-page flex min-h-[78vh] flex-col items-start justify-end pb-16 pt-28 text-sand-50 sm:min-h-[82vh]">
    <div class="max-w-2xl animate-fade-up">
      <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-sand-50/30 bg-sand-50/10 px-4 py-1.5 text-sm font-medium backdrop-blur-sm">
        <span class="inline-block h-1.5 w-1.5 rotate-45 bg-gold-400"></span>
        {site.tagline}
      </p>
      <h1 class="font-serif text-4xl font-black leading-[1.1] sm:text-5xl md:text-6xl">
        קיסריה — עיר שבנו מלכים,<br />וחפר הים
      </h1>
      <p class="mt-6 max-w-xl text-lg text-sand-100/95 sm:text-xl">
        מאגר עשיר של מאמרים, סיפורים ותגליות על אחת הערים המרתקות בארץ —
        מאת מדריך שחי ונושם את קיסריה.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href={url('/articles')}
          class="rounded-full bg-terracotta-500 px-7 py-3 font-medium text-sand-50 shadow-lg transition-transform hover:-translate-y-0.5 hover:bg-terracotta-600"
        >
          לקריאת המאמרים
        </a>
        <a
          href={url('/tours')}
          class="rounded-full border border-sand-50/50 bg-sand-50/5 px-7 py-3 font-medium text-sand-50 backdrop-blur-sm transition-colors hover:bg-sand-50/15"
        >
          על הסיורים
        </a>
      </div>
    </div>
  </div>
</section>
