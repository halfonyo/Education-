---
// כפתור וואטסאפ צף — מופיע בכל עמודי האתר, עם הודעת פתיחה מוכנה
import { whatsappUrl } from '../site.config';
---

<a
  href={whatsappUrl()}
  target="_blank"
  rel="noopener"
  class="wa-fab"
  aria-label="שליחת הודעה בוואטסאפ"
>
  <svg width="30" height="30" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
    <path d="M16.04 4c-6.63 0-12 5.37-12 12 0 2.11.55 4.17 1.6 5.98L4 28l6.2-1.62A11.9 11.9 0 0 0 16.04 28c6.63 0 12-5.37 12-12s-5.37-12-12-12Zm0 21.9c-1.86 0-3.68-.5-5.27-1.44l-.38-.22-3.68.96.98-3.59-.25-.37a9.86 9.86 0 0 1-1.51-5.24c0-5.46 4.44-9.9 9.9-9.9 2.64 0 5.13 1.03 7 2.9a9.84 9.84 0 0 1 2.9 7c0 5.46-4.44 9.9-9.9 9.9Zm5.43-7.41c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35Z"/>
  </svg>
</a>

<style>
  .wa-fab {
    position: fixed;
    inset-block-end: 1.4rem;
    inset-inline-start: 1.4rem;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 3.6rem;
    block-size: 3.6rem;
    border-radius: 999px;
    background: #25d366;
    color: #fff;
    box-shadow: 0 10px 26px -8px rgba(37, 211, 102, 0.65), 0 4px 10px rgba(0, 0, 0, 0.15);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .wa-fab:hover {
    transform: translateY(-3px) scale(1.04);
    box-shadow: 0 16px 32px -8px rgba(37, 211, 102, 0.7), 0 6px 12px rgba(0, 0, 0, 0.18);
  }
  .wa-fab::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 999px;
    box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5);
    animation: wa-pulse 2.4s ease-out infinite;
  }
  @keyframes wa-pulse {
    0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.45); }
    70% { box-shadow: 0 0 0 16px rgba(37, 211, 102, 0); }
    100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-fab::before { animation: none; }
    .wa-fab:hover { transform: none; }
  }
</style>
