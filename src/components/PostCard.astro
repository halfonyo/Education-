---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const { title, description, category, heroImage, heroImageAlt, publishDate } = post.data;

const dateLabel = new Intl.DateTimeFormat('he-IL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishDate);
---

<article
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-xl border border-sand-300/70 bg-sand-50 shadow-sm transition-all hover:-translate-y-1 hover:shadow-[var(--shadow-warm)]',
    featured ? 'md:flex-row' : '',
  ]}
>
  <a href={`/articles/${post.slug}`} class="block overflow-hidden" class:list={[featured ? 'md:w-1/2' : '']}>
    <div class:list={['overflow-hidden', featured ? 'h-64 md:h-full' : 'h-52']}>
      <img
        src={heroImage}
        alt={heroImageAlt}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </div>
  </a>

  <div class:list={['flex flex-1 flex-col p-5', featured ? 'md:justify-center md:p-8' : '']}>
    <span class="mb-3 inline-flex w-fit items-center rounded-full bg-sea-500/10 px-3 py-1 text-xs font-medium text-sea-600">
      {category}
    </span>
    <h3
      class:list={[
        'font-serif font-bold leading-snug text-ink-900 transition-colors group-hover:text-terracotta-500',
        featured ? 'text-2xl md:text-3xl' : 'text-xl',
      ]}
    >
      <a href={`/articles/${post.slug}`} class="after:absolute after:inset-0">
        {title}
      </a>
    </h3>
    <p class="mt-3 line-clamp-3 text-sm text-ink-500">{description}</p>
    <time datetime={publishDate.toISOString()} class="mt-4 text-xs text-ink-500/80">
      {dateLabel}
    </time>
  </div>
</article>
