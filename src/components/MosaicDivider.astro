---
// מפריד דקורטיבי בהשראת פסיפס רומי — מחליף קו הפרדה רגיל
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class={`flex items-center justify-center gap-3 py-2 ${className}`} aria-hidden="true">
  <span class="h-px w-16 bg-gradient-to-l from-transparent to-gold-500/70"></span>
  <svg width="60" height="20" viewBox="0 0 60 20" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="26" y="2" width="8" height="8" transform="rotate(45 30 6)" fill="var(--color-terracotta-500)" />
    <rect x="12" y="6" width="5" height="5" transform="rotate(45 14.5 8.5)" fill="var(--color-sea-500)" />
    <rect x="44" y="6" width="5" height="5" transform="rotate(45 46.5 8.5)" fill="var(--color-sea-500)" />
    <rect x="1" y="7" width="3.5" height="3.5" transform="rotate(45 2.75 8.75)" fill="var(--color-gold-500)" />
    <rect x="55" y="7" width="3.5" height="3.5" transform="rotate(45 56.75 8.75)" fill="var(--color-gold-500)" />
  </svg>
  <span class="h-px w-16 bg-gradient-to-r from-transparent to-gold-500/70"></span>
</div>
