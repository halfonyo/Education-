---
import { url } from '../site.config';

interface Props {
  title?: string;
  text?: string;
  variant?: 'full' | 'inline';
}
const {
  title = 'רוצים לחוות את זה בשטח?',
  text = 'כל אבן בקיסריה מספרת סיפור. בסיור מודרך נחבר בין ההיסטוריה למה שרואים בעיניים, ותצאו עם חוויה שנשארת.',
  variant = 'full',
} = Astro.props;
---

<section
  class:list={[
    'relative overflow-hidden text-sand-50',
    variant === 'full' ? 'my-4' : 'my-12 rounded-2xl',
  ]}
>
  <div
    class="relative bg-sea-700 bg-cover bg-center bg-no-repeat"
    style={`background-image: linear-gradient(180deg, rgba(18,59,64,0.86) 0%, rgba(13,43,48,0.76) 45%, rgba(10,34,37,0.92) 100%), url('${url('/images/photos/aqueduct-real.webp')}');`}
  >
    <div class="container-page relative py-16 text-center">
      <h2 class="relative mx-auto max-w-2xl font-serif text-3xl font-bold sm:text-4xl">
        {title}
      </h2>
      <p class="relative mx-auto mt-4 max-w-xl text-sand-50/95">
        {text}
      </p>
      <div class="relative mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href={url('/tours')}
          class="rounded-full bg-gold-500 px-7 py-3 font-medium text-sea-700 shadow-sm transition-transform hover:-translate-y-0.5 hover:bg-gold-400"
        >
          לפרטי הסיורים
        </a>
      </div>
    </div>
  </div>
</section>
