---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import MosaicDivider from '../../components/MosaicDivider.astro';
import { site, url } from '../../site.config';

const title = 'הסיור המלא בקיסריה';
const description =
  'המסלול המלא בגן הלאומי קיסריה: מהדגם והתיאטרון, דרך ארמון השונית, ההיפודרום והמרחצאות, אל העיר הצלבנית והנמל, בית הכנסת העתיק ואמת המים.';
const heroImage = '/images/photos/kesaria-full.webp';
const heroImageAlt =
  'שרידי קיסריה בגן הלאומי: קיר קשתות וגרם מדרגות מונומנטלי על רקע שמי תכלת';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: title,
  description,
  image: new URL(url(heroImage), Astro.site).href,
  provider: { '@type': 'Person', name: site.guideName },
  touristType: 'תיירות היסטורית וארכיאולוגית',
};
---

<BaseLayout title={title} description={description} image={heroImage} jsonLd={jsonLd}>
  <header class="relative isolate overflow-hidden">
    <img src={url(heroImage)} alt={heroImageAlt} class="absolute inset-0 -z-10 h-full w-full object-cover" fetchpriority="high" />
    <div
      class="absolute inset-0 -z-10"
      style="background: linear-gradient(180deg, rgba(27,57,68,0.12) 0%, rgba(27,57,68,0.18) 38%, rgba(27,57,68,0.60) 72%, rgba(27,57,68,0.93) 100%);"
      aria-hidden="true"
    >
    </div>
    <div class="container-prose flex min-h-[52vh] flex-col justify-end pb-12 pt-28 text-sand-50" style="text-shadow: 0 2px 16px rgba(11,26,32,0.6);">
      <a href={url('/tours')} class="mb-4 inline-flex w-fit items-center gap-1.5 text-sm text-sand-100/90 hover:text-gold-400">
        חזרה לכל הסיורים
      </a>
      <span class="mb-3 inline-flex w-fit rounded-full bg-sand-50/15 px-3 py-1 text-xs font-medium backdrop-blur-sm" style="text-shadow: none;">
        סיור מודרך
      </span>
      <h1 class="font-serif text-4xl leading-tight text-sand-50 sm:text-5xl md:text-6xl">
        {title}
      </h1>
      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-sand-100/90">
        <span>מאת {site.guideName}</span>
      </div>
    </div>
  </header>

  <article class="container-prose py-14">
    <div class="prose-body">
      <p>
        נתחיל דווקא לא באבן אלא בתמונה הגדולה. ליד התיאטרון ניצב דגם של העיר, ולפניו נעצור
        רגע כדי להבין מה אנחנו עומדים לראות. קיסריה לא צמחה לאט כמו רוב הערים, היא קמה בבת
        אחת, כחזון מוגמר, כשהמלך הורדוס החליט בשלהי המאה הראשונה לפני הספירה להקים על חוף
        חולי ושומם עיר נמל שתתחרה בגדולות שבים התיכון. מן הדגם רואים את ההיגיון: רחובות
        ישרים ברשת, מקדש שמשקיף אל הים, נמל, תיאטרון והיפודרום, וכל אלה סביב לב אחד,
        <a href={url('/articles/herod-harbor')}>הנמל סבסטוס</a>. משם עברה העיר יד ליד לאורך
        הדורות, רומא, ביזנטיון, האסלאם הקדום, הצלבנים, ולבסוף הממלוכים שהחריבו אותה. כל
        שכבה השאירה חותם, וכל מה שנלך בו היום הוא סיפור של עלייה ונפילה על אותו חוף.
      </p>

      <h2>התיאטרון</h2>
      <p>
        מהדגם נעלה אל <a href={url('/articles/roman-theater')}>התיאטרון</a>, המבנה מסוגו
        העתיק ביותר שנחשף בארץ. בעבר, מי שעמד במרכז הבמה ודיבר בקול רגיל נשמע היטב עד
        השורה העליונה, וזה בזכות קיר גבוה שהתנשא מאחורי הבמה והחזיר את הקול אל יציע הצופים
        כמו מגביר טבעי. הקיר הזה ברובו כבר אינו עומד, אבל כשמדמיינים אותו מבינים איך אלפי
        אנשים שמעו כאן שחקן בודד בלי חשמל. דווקא כאן נמצאה בשנת 1961 אבן ועליה שמו של
        פונטיוס פילטוס, מושל יהודה, העדות הארכיאולוגית היחידה לשמו מזמנו. התיאטרון, ששימש
        במרוצת הדורות מחצבה ומבצר, חזר לתפקידו המקורי ומארח היום מופעים בפני אלפי צופים.
      </p>

      <h2>ארמון השונית, ההיפודרום ובית המרחץ</h2>
      <p>
        נמשיך אל קצה העיר הפונה לים. כאן חדר הורדוס עם ארמון אל תוך הגלים, ארמון השונית,
        ובמרכזו חצב בריכת מים מתוקים בלב הים המלוח. לימים הפך הארמון למעון הנציב הרומי.
        לצדו משתרע <a href={url('/articles/hippodrome')}>ההיפודרום</a>, זירת מרוצי המרכבות
        שהכילה כעשרת אלפים צופים, המקום הרועש ביותר של העיר. ומעט צפונה נעצור בבית המרחץ
        הציבורי, עם רצפות הפסיפס והמערכת שחיממה את המים והזרימה אותם. שלושתם יחד מספרים על
        עיר שידעה לחיות בגדול.
      </p>

      <h2>העיר הצלבנית והנמל</h2>
      <p>
        נעבור על גשר מעל חפיר עמוק וניכנס אל <a href={url('/articles/crusader-caesarea')}>העיר
        הצלבנית</a>, וכאן מפתיע לגלות עד כמה היא קטנה. הצלבנים, ובראשם לואי התשיעי מלך
        צרפת, ביצרו עיר זעירה בתוך שטחה העצום של קיסריה הרומית, שבריר ממה שהיה כאן. החומות,
        השער והחפיר שאנחנו רואים הם בעיקר שלהם. מעבר להם נפרש הנמל, סבסטוס, שהיה פעם פלא
        הנדסי גדול ושקע אל מתחת למים. שמו יווני, "הנשגב", תרגום של התואר "אוגוסטוס", ושרידיו
        עדיין שוכנים מתחת לפני המים.
      </p>

      <h2>מרכז המבקרים החדש</h2>
      <p>
        בשערי הנמל ניכנס אל מרכז המבקרים החדש, המשולב בתוך קמרונות הרודיאניים ששימשו במקור
        מחסני הנמל. במקום שבו אוחסנו פעם סחורות שהגיעו מכל הים התיכון, מקבלת היום כל שכבת
        היסטוריה את קולה במיצג, ואפשר לעצור, לשבת, ולחבר את מה שראינו בשטח לרצף אחד.
      </p>

      <h2>בית הכנסת העתיק, ואמת המים</h2>
      <p>
        משם נצא אל צפון העיר, אל בית הכנסת העתיק שעל שפת הים. דווקא במקום הזה, בעיר שהחריבה
        את המקדש, נמצאה <a href={url('/articles/mishmarot-kehuna')}>כתובת ובה רשימת עשרים
        וארבע משמרות הכהונה</a> ומקומות יישובן בגליל, זיכרון של סדר עבודה שנקטע ולא נשכח.
        מכאן, מי שירצה, יכול להמשיך אל הקטע המפורסם של <a href={url('/articles/aqueduct')}>אמת
        המים</a>, שורת הקשתות שעל החוף. ההליכה מבית הכנסת אל חוף הקשתות אורכת כעשרים דקות,
        והיא דורשת חזרה ברגל אל הגן הלאומי או תיאום הקפצת רכבים, ולכן טוב לתכנן אותה מראש.
      </p>

      <h2>ומי שנותר לו זמן, מחוץ לעיר</h2>
      <p>
        מחוץ לגן הלאומי מסתתרים עוד כמה אוצרות. בתוך שטח האולם של יקבי קיסריה, בקטע עתיק של
        רחוב מרוצף, עומדים שני פסלי קיסר מן התקופה הרומית-ביזנטית, אחד משיש לבן ואחד מפורפיר
        אדום, שניהם בלי ראש, שרידים של פאר שלטוני. ובקרבת מקום אפשר לראות את פסיפס הציפורים
        המרהיב, רצפה ביזנטית שכולה ציפורים, ואת שרידי ההיפודרום הביזנטי הגדול.
      </p>

      <p>
        בסוף ההליכה, כשנעמוד ונביט אחורה על כל מה שעברנו, נבין שקיסריה היא בעצם סיפור אחד
        גדול על כוח. מלך שבנה יש מאין, אימפריה ששלטה, צלבנים שהצטמצמו, וים שלקח הכול בחזרה.
        ודווקא בתוך כל הפאר הזה, מה שנשאר חי אינו החומה ולא הזירה, אלא הכתובת הקטנה בבית
        הכנסת ששמרה על סדר שלא נשכח. <a href={url('/articles/kisari-yerushalayim')}>"חרבה קסרי
        וישבה ירושלים"</a>, אמרו חכמים, ואנחנו, שהלכנו היום בין החורבות, ראינו זאת במו
        עינינו.
      </p>
    </div>
  </article>

  <CTASection variant="inline" />

  <section class="container-page pb-14">
    <MosaicDivider class="mb-8" />
    <div class="text-center">
      <a
        href={url('/tours')}
        class="inline-block rounded-full bg-sea-500 px-6 py-2.5 font-medium text-sand-50 transition-colors hover:bg-sea-600"
      >
        לכל הסיורים
      </a>
    </div>
  </section>
</BaseLayout>
