---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PostCard from '../components/PostCard.astro';
import CTASection from '../components/CTASection.astro';
import MosaicDivider from '../components/MosaicDivider.astro';
import { site, url } from '../site.config';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const featured = allPosts.filter((p) => p.data.featured).slice(0, 1);
const recent = allPosts.filter((p) => !featured.includes(p)).slice(0, 4);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: 'קיסריה העתיקה',
  description: site.description,
  touristType: 'תיירות היסטורית וארכיאולוגית',
  url: Astro.site?.href,
};
---

<BaseLayout jsonLd={jsonLd}>
  <Hero
    image="/images/illustrations/hero-home.webp"
    imageAlt="נוף קיסריה העתיקה בשקיעה — מקדש רומי על הצוק, הנמל המתעקל, התיאטרון וקרדו העמודים מול הים"
  />

  <!-- פתיח / הבטחת ערך -->
  <section class="container-prose py-16 text-center">
    <MosaicDivider class="mb-8" />
    <h2 class="font-serif text-3xl text-ink-900 sm:text-4xl">לא עוד ערימת אבנים</h2>
    <p class="mt-5 text-lg text-ink-700">
      קיסריה היא אחד המקומות המרתקים בישראל — עיר שבנה מלך שאפתן, שגשגה תחת רומא וביזנטיון,
      נכבשה בידי צלבנים ושקעה אל הים. כאן תמצאו מאגר מאמרים שמחזיר לה את הקול: היסטוריה,
      ארכיטקטורה, תגליות וסיפורים, כתובים בשפה בהירה ומדויקת.
    </p>
  </section>

  <!-- פוסט מוביל -->
  {
    featured.length > 0 && (
      <section class="container-page pb-6">
        <h2 class="rule-gold mb-8 font-serif text-2xl text-ink-900">מומלץ להתחיל כאן</h2>
        <PostCard post={featured[0]} featured />
      </section>
    )
  }

  <!-- פוסטים אחרונים -->
  <section class="container-page py-12">
    <div class="mb-8 flex items-end justify-between">
      <h2 class="rule-gold font-serif text-2xl text-ink-900">מהמאמרים האחרונים</h2>
      <a href={url('/articles')} class="text-sm font-medium text-terracotta-500 hover:text-terracotta-600">
        לכל המאמרים →
      </a>
    </div>
    <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
      {recent.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <!-- טיזר אודות -->
  <section class="container-page py-12">
    <div class="grid items-center gap-10 rounded-2xl border border-sand-300/70 bg-sand-50 p-8 md:grid-cols-2 md:p-12">
      <div>
        <p class="mb-2 text-sm font-medium tracking-wide text-sea-500">מי אני</p>
        <h2 class="font-serif text-3xl text-ink-900">מדריך שחי את קיסריה</h2>
        <p class="mt-4 text-ink-700">
          שנים של הדרכה, קריאה וחפירה בסיפורים הפכו את קיסריה מאתר לתשוקה.
          המטרה שלי פשוטה: שתצאו מהסיור רואים את העיר אחרת לגמרי.
        </p>
        <a
          href={url('/about')}
          class="mt-6 inline-block rounded-full bg-sea-500 px-6 py-2.5 font-medium text-sand-50 transition-colors hover:bg-sea-600"
        >
          קראו עוד עליי
        </a>
      </div>
      <div class="overflow-hidden rounded-xl shadow-[var(--shadow-warm)]">
        <img
          src={url('/images/illustrations/about-portrait.svg')}
          alt="דיוקן המדריך על רקע חופי קיסריה"
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
