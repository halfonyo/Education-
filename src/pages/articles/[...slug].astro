---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import MosaicDivider from '../../components/MosaicDivider.astro';
import PostCard from '../../components/PostCard.astro';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { Content } = await post.render();
const { title, description, category, heroImage, heroImageAlt, publishDate, tags, readingTime } =
  post.data;

const dateLabel = new Intl.DateTimeFormat('he-IL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishDate);

// פוסטים קשורים — מאותה קטגוריה, אחרת אחרונים
const all = (await getCollection('posts', ({ data }) => !data.draft)).filter(
  (p) => p.slug !== post.slug
);
const related = [
  ...all.filter((p) => p.data.category === category),
  ...all.filter((p) => p.data.category !== category),
]
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: new URL(heroImage, Astro.site).href,
  datePublished: publishDate.toISOString(),
  articleSection: category,
  author: { '@type': 'Person', name: site.guideName },
  publisher: { '@type': 'Organization', name: site.name },
  mainEntityOfPage: Astro.url.href,
};
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  publishDate={publishDate}
  jsonLd={jsonLd}
>
  <!-- כותרת עם תמונת רקע -->
  <header class="relative isolate overflow-hidden">
    <img src={heroImage} alt={heroImageAlt} class="absolute inset-0 -z-10 h-full w-full object-cover" fetchpriority="high" />
    <div class="absolute inset-0 -z-10" style="background: linear-gradient(180deg, rgba(42,35,28,0.35), rgba(42,35,28,0.78));" aria-hidden="true"></div>
    <div class="container-prose flex min-h-[52vh] flex-col justify-end pb-12 pt-28 text-sand-50">
      <a href="/articles" class="mb-4 inline-flex w-fit items-center gap-1.5 text-sm text-sand-100/90 hover:text-gold-400">
        → חזרה לכל המאמרים
      </a>
      <span class="mb-3 inline-flex w-fit rounded-full bg-sand-50/15 px-3 py-1 text-xs font-medium backdrop-blur-sm">
        {category}
      </span>
      <h1 class="font-serif text-3xl font-black leading-tight sm:text-4xl md:text-5xl">
        {title}
      </h1>
      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-sand-100/90">
        <span>מאת {site.guideName}</span>
        <span aria-hidden="true">·</span>
        <time datetime={publishDate.toISOString()}>{dateLabel}</time>
        {readingTime && <><span aria-hidden="true">·</span><span>{readingTime} דק׳ קריאה</span></>}
      </div>
    </div>
  </header>

  <!-- גוף המאמר -->
  <article class="container-prose py-14">
    <div class="prose-body dropcap">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <div class="mt-12 flex flex-wrap gap-2 border-t border-sand-300 pt-6">
          {tags.map((tag) => (
            <span class="rounded-full bg-sand-200 px-3 py-1 text-xs text-ink-700">#{tag}</span>
          ))}
        </div>
      )
    }
  </article>

  <CTASection variant="inline" />

  <!-- פוסטים קשורים -->
  {
    related.length > 0 && (
      <section class="container-page py-14">
        <MosaicDivider class="mb-8" />
        <h2 class="rule-gold mb-8 font-serif text-2xl text-ink-900">להמשך הקריאה</h2>
        <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => <PostCard post={p} />)}
        </div>
      </section>
    )
  }
</BaseLayout>
